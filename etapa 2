
#include <iostream>
#include <string>
#include <iomanip>

using namespace std;

int main() {

    // Limite de contas e movimentacoes
    const int MAX_CONTAS = 100;
    const int MAX_MOVIMENTACOES = 500;

    // Arrays das contas
    int numeroConta[MAX_CONTAS];
    string nomeCliente[MAX_CONTAS];
    string cpf[MAX_CONTAS];
    int tipoConta[MAX_CONTAS];
    double saldo[MAX_CONTAS];
    bool contaAtiva[MAX_CONTAS];

    int quantidadeContas = 0;

    // Arrays do historico de movimentacoes
    int contaMovimentacao[MAX_MOVIMENTACOES];
    char tipoMovimentacao[MAX_MOVIMENTACOES];
    double valorMovimentacao[MAX_MOVIMENTACOES];

    int quantidadeMovimentacoes = 0;

    int opcao;

    cout << fixed << setprecision(2);

    // Menu principal
    do {

        cout << "\n********************************" << endl;
        cout << "          BANCO INF101" << endl;
        cout << "********************************" << endl;

        cout << "1 - Cadastrar conta" << endl;
        cout << "2 - Listar contas" << endl;
        cout << "3 - Consultar conta" << endl;
        cout << "4 - Realizar deposito" << endl;
        cout << "5 - Realizar saque" << endl;
        cout << "6 - Realizar transferencia" << endl;
        cout << "7 - Exibir extrato" << endl;
        cout << "8 - Alterar tipo da conta" << endl;
        cout << "9 - Ativar/Desativar conta" << endl;
        cout << "10 - Sair" << endl;

        cout << "\nEscolha uma opcao: ";
        cin >> opcao;

        switch (opcao) {

            // CADASTRAR CONTA
            case 1: {

                if (quantidadeContas >= MAX_CONTAS) {
                    cout << "\nLimite de contas atingido!" << endl;
                    break;
                }

                int numero;
                bool existe = false;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                // Verifica se o numero e positivo
                if (numero <= 0) {
                    cout << "Numero da conta invalido!" << endl;
                    break;
                }

                // Verifica se a conta ja existe
                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        existe = true;
                    }
                }

                if (existe) {
                    cout << "Essa conta ja esta cadastrada!" << endl;
                    break;
                }

                numeroConta[quantidadeContas] = numero;

                cin.ignore();

                cout << "Nome do cliente: ";
                getline(cin, nomeCliente[quantidadeContas]);

                cout << "CPF do cliente: ";
                getline(cin, cpf[quantidadeContas]);

                cout << "Tipo da conta (1 - Corrente / 2 - Poupanca): ";
                cin >> tipoConta[quantidadeContas];

                if (tipoConta[quantidadeContas] != 1 &&
                    tipoConta[quantidadeContas] != 2) {

                    cout << "Tipo de conta invalido!" << endl;
                    break;
                }

                cout << "Saldo inicial: R$ ";
                cin >> saldo[quantidadeContas];

                if (saldo[quantidadeContas] < 0) {
                    cout << "O saldo nao pode ser negativo!" << endl;
                    break;
                }

                contaAtiva[quantidadeContas] = true;

                quantidadeContas++;

                cout << "\nConta cadastrada com sucesso!" << endl;

                break;
            }

            // LISTAR CONTAS
            case 2: {

                if (quantidadeContas == 0) {
                    cout << "\nNenhuma conta cadastrada!" << endl;
                    break;
                }

                cout << "\n====== CONTAS CADASTRADAS ======" << endl;

                for (int i = 0; i < quantidadeContas; i++) {

                    cout << "\nNumero: " << numeroConta[i] << endl;
                    cout << "Cliente: " << nomeCliente[i] << endl;
                    cout << "CPF: " << cpf[i] << endl;

                    if (tipoConta[i] == 1) {
                        cout << "Tipo: Corrente" << endl;
                    } else {
                        cout << "Tipo: Poupanca" << endl;
                    }

                    cout << "Saldo: R$ " << saldo[i] << endl;

                    if (contaAtiva[i]) {
                        cout << "Situacao: Ativa" << endl;
                    } else {
                        cout << "Situacao: Desativada" << endl;
                    }
                }

                break;
            }

            // CONSULTAR CONTA
            case 3: {

                int numero;
                int indice = -1;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                } else {

                    cout << "\n====== DADOS DA CONTA ======" << endl;
                    cout << "Numero: " << numeroConta[indice] << endl;
                    cout << "Cliente: " << nomeCliente[indice] << endl;
                    cout << "CPF: " << cpf[indice] << endl;
                    cout << "Saldo: R$ " << saldo[indice] << endl;

                    if (tipoConta[indice] == 1) {
                        cout << "Tipo: Corrente" << endl;
                    } else {
                        cout << "Tipo: Poupanca" << endl;
                    }

                    if (contaAtiva[indice]) {
                        cout << "Situacao: Ativa" << endl;
                    } else {
                        cout << "Situacao: Desativada" << endl;
                    }
                }

                break;
            }

            // REALIZAR DEPOSITO
            case 4: {

                int numero;
                int indice = -1;
                double valor;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                if (!contaAtiva[indice]) {
                    cout << "A conta esta desativada!" << endl;
                    break;
                }

                if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                    cout << "Historico de movimentacoes cheio!" << endl;
                    break;
                }

                cout << "Digite o valor do deposito: R$ ";
                cin >> valor;

                if (valor <= 0) {
                    cout << "Valor invalido!" << endl;
                    break;
                }

                saldo[indice] = saldo[indice] + valor;

                // Registra a movimentacao
                contaMovimentacao[quantidadeMovimentacoes] = numeroConta[indice];
                tipoMovimentacao[quantidadeMovimentacoes] = 'D';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                cout << "Deposito realizado com sucesso!" << endl;
                cout << "Novo saldo: R$ " << saldo[indice] << endl;

                break;
            }

            // REALIZAR SAQUE
            case 5: {

                int numero;
                int indice = -1;
                double valor;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                if (!contaAtiva[indice]) {
                    cout << "A conta esta desativada!" << endl;
                    break;
                }

                if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                    cout << "Historico de movimentacoes cheio!" << endl;
                    break;
                }

                cout << "Digite o valor do saque: R$ ";
                cin >> valor;

                if (valor <= 0) {
                    cout << "Valor invalido!" << endl;
                    break;
                }

                if (valor > saldo[indice]) {
                    cout << "Saldo insuficiente!" << endl;
                    break;
                }

                saldo[indice] = saldo[indice] - valor;

                // Registra a movimentacao
                contaMovimentacao[quantidadeMovimentacoes] = numeroConta[indice];
                tipoMovimentacao[quantidadeMovimentacoes] = 'S';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                cout << "Saque realizado com sucesso!" << endl;
                cout << "Novo saldo: R$ " << saldo[indice] << endl;

                break;
            }

            // REALIZAR TRANSFERENCIA
            case 6: {

                int origem, destino;
                int indiceOrigem = -1;
                int indiceDestino = -1;
                double valor;

                cout << "\nConta de origem: ";
                cin >> origem;

                cout << "Conta de destino: ";
                cin >> destino;

                for (int i = 0; i < quantidadeContas; i++) {

                    if (numeroConta[i] == origem) {
                        indiceOrigem = i;
                    }

                    if (numeroConta[i] == destino) {
                        indiceDestino = i;
                    }
                }

                if (indiceOrigem == -1 || indiceDestino == -1) {
                    cout << "Uma das contas nao foi encontrada!" << endl;
                    break;
                }

                if (indiceOrigem == indiceDestino) {
                    cout << "Nao e possivel transferir para a mesma conta!" << endl;
                    break;
                }

                if (!contaAtiva[indiceOrigem] ||
                    !contaAtiva[indiceDestino]) {

                    cout << "Uma das contas esta desativada!" << endl;
                    break;
                }

                // A transferencia precisa de dois registros
                if (quantidadeMovimentacoes + 2 > MAX_MOVIMENTACOES) {
                    cout << "Espaco insuficiente no historico!" << endl;
                    break;
                }

                cout << "Valor da transferencia: R$ ";
                cin >> valor;

                if (valor <= 0) {
                    cout << "Valor invalido!" << endl;
                    break;
                }

                if (valor > saldo[indiceOrigem]) {
                    cout << "Saldo insuficiente!" << endl;
                    break;
                }

                // Atualiza os saldos
                saldo[indiceOrigem] = saldo[indiceOrigem] - valor;
                saldo[indiceDestino] = saldo[indiceDestino] + valor;

                // Registra a saida da conta de origem
                contaMovimentacao[quantidadeMovimentacoes] = origem;
                tipoMovimentacao[quantidadeMovimentacoes] = 'S';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                // Registra a entrada na conta de destino
                contaMovimentacao[quantidadeMovimentacoes] = destino;
                tipoMovimentacao[quantidadeMovimentacoes] = 'D';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                cout << "Transferencia realizada com sucesso!" << endl;

                break;
            }

            // EXIBIR EXTRATO
            case 7: {

                int numero;
                int indice = -1;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                cout << "\n====== EXTRATO BANCARIO ======" << endl;
                cout << "Cliente: " << nomeCliente[indice] << endl;
                cout << "Conta: " << numeroConta[indice] << endl;

                bool encontrou = false;

                for (int i = 0; i < quantidadeMovimentacoes; i++) {

                    if (contaMovimentacao[i] == numero) {

                        encontrou = true;

                        if (tipoMovimentacao[i] == 'D') {
                            cout << "Deposito/Entrada: R$ "
                                 << valorMovimentacao[i] << endl;
                        }

                        else if (tipoMovimentacao[i] == 'S') {
                            cout << "Saque/Saida: R$ "
                                 << valorMovimentacao[i] << endl;
                        }
                    }
                }

                if (!encontrou) {
                    cout << "Nenhuma movimentacao registrada." << endl;
                }

                cout << "Saldo atual: R$ " << saldo[indice] << endl;

                break;
            }

            // ALTERAR TIPO DA CONTA
            case 8: {

                int numero;
                int indice = -1;
                int novoTipo;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                cout << "Novo tipo (1 - Corrente / 2 - Poupanca): ";
                cin >> novoTipo;

                if (novoTipo != 1 && novoTipo != 2) {
                    cout << "Tipo invalido!" << endl;
                    break;
                }

                tipoConta[indice] = novoTipo;

                cout << "Tipo de conta alterado com sucesso!" << endl;

                break;
            }

            // ATIVAR OU DESATIVAR CONTA
            case 9: {

                int numero;
                int indice = -1;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                contaAtiva[indice] = !contaAtiva[indice];

                if (contaAtiva[indice]) {
                    cout << "Conta ativada com sucesso!" << endl;
                } else {
                    cout << "Conta desativada com sucesso!" << endl;
                }

                break;
            }

            // SAIR
            case 10:
                cout << "\nEncerrando o Banco INF101..." << endl;
                break;

            default:
                cout << "\nOpcao invalida!" << endl;
        }

    } while (opcao != 10);

    return 0;
}


<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">

    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/index.css">
    <link rel="stylesheet" href="css/acessibilidade.css">
    <link rel="stylesheet" href="css/privacidade.css">
    <link rel="icon" type="image/svg+xml" href="assets/icons/logo.svg">

    <title>Praça para Todos</title>

    <style>
        #rotas-acessiveis-titulo {
            margin: 0 0 1.6rem;
            color: #3b1e5d;
            font-size: clamp(3.5rem, 8vw, 6rem);
            font-weight: 800;
            letter-spacing: -0.045em;
            line-height: 0.98;
        }

        .rotas-sobretitulo {
            margin: 0 0 1.25rem;
            color: #7040bb;
            font-size: 0.95rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            line-height: 1.4;
            text-transform: uppercase;
        }

        .rotas-destaque {
            margin: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(3.5rem, 7vw, 6rem);
            padding: clamp(1.5rem, 3vw, 2.5rem);
            border-radius: 1.5rem;
            background: linear-gradient(110deg, #7040bb 0%, #3b1e5d 100%);
            box-shadow: 0 18px 40px rgba(59, 30, 93, 0.15);
            color: #fff;
            font-size: clamp(1.1rem, 1.7vw, 1.4rem);
            font-weight: 600;
            line-height: 1.65;
        }

        #detalhes-tecnicos-titulo {
            margin-bottom: 2rem;
        }

        .cartao-detalhe {
            display: grid;
            grid-template-columns: minmax(280px, 1fr) minmax(0, 1fr);
            align-items: center;
            gap: clamp(2rem, 4.5vw, 4.25rem);
            padding: clamp(1.5rem, 3vw, 2.75rem);
            margin: 2rem 0;
            border: 1px solid #e6def1;
            border-radius: 2rem;
            background: #fff;
            box-shadow: 0 18px 45px rgba(59, 30, 93, 0.08);
        }

        .cartao-detalhe figure {
            position: relative;
            min-width: 0;
            margin: 0;
            isolation: isolate;
        }

        .cartao-detalhe figure::before {
            position: absolute;
            z-index: -1;
            top: -1.25rem;
            left: -1.25rem;
            width: 44%;
            height: 58%;
            border-radius: 2rem;
            background: #e5d8fb;
            content: "";
        }

        .cartao-detalhe figure img {
            display: block;
            width: 100%;
            height: clamp(320px, 42vw, 560px);
            object-fit: cover;
            object-position: center;
            border-radius: 2rem;
        }

        .cartao-detalhe figcaption {
            margin-top: 0.65rem;
            color: #514b60;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .detalhe-numero {
            display: inline-grid;
            width: 4.5rem;
            aspect-ratio: 1;
            place-items: center;
            margin-bottom: 0.75rem;
            border-radius: 50%;
            background: #e8dcfb;
            color: #4b168f;
            font-size: 1.1rem;
            font-weight: 800;
        }

        .detalhe-conteudo h3 {
            position: relative;
            margin: 0 0 1.75rem;
            color: #3b1681;
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            line-height: 1.2;
        }

        .detalhe-conteudo h3::after {
            position: absolute;
            bottom: -0.8rem;
            left: 0;
            width: 5rem;
            height: 4px;
            border-radius: 999px;
            background: #7844d1;
            content: "";
        }

        .detalhe-conteudo > p {
            margin: 0 0 1.5rem;
            color: #413650;
            font-size: 1.05rem;
            line-height: 1.75;
        }

        .detalhe-conteudo h4 {
            margin: 1.25rem 0 0;
            padding: 1rem 1.25rem 0.5rem;
            border-radius: 1.25rem 1.25rem 0 0;
            background: #f0e9fc;
            color: #4b168f;
            font-size: 1.15rem;
        }

        .detalhe-conteudo ul {
            display: grid;
            gap: 0.55rem;
            margin: 0 0 1.25rem;
            padding: 0.5rem 1.25rem 1.2rem 3.5rem;
            border-radius: 0 0 1.25rem 1.25rem;
            background: #f0e9fc;
            color: #29154c;
            line-height: 1.6;
            list-style: none;
        }

        .detalhe-conteudo li {
            position: relative;
        }

        .detalhe-conteudo li::before {
            position: absolute;
            top: 0.1rem;
            left: -1.65rem;
            display: grid;
            width: 1.15rem;
            height: 1.15rem;
            place-items: center;
            border-radius: 50%;
            background: #7040bb;
            color: #fff;
            content: "✓";
            font-size: 0.75rem;
            font-weight: 800;
        }

        .detalhe-referencia {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 1.1rem 1.25rem;
            border: 1px solid #e0d2f8;
            border-radius: 1.25rem;
            background: #e9ddfb;
            color: #3b1681;
            font-size: 1rem;
            font-weight: 600;
            line-height: 1.5;
        }

        .detalhe-referencia::before {
            flex: 0 0 auto;
            color: #4b168f;
            content: "▤";
            font-size: 1.7rem;
            line-height: 1;
        }

        .quadro-dimensional-imagem {
            width: 100%;
            max-width: 650px;
            margin: 3rem auto;
        }

        .quadro-dimensional-imagem img {
            display: block;
            width: 100%;
            max-width: 100%;
            height: auto;
            border-radius: 1rem;
            box-shadow: 0 14px 38px rgba(59, 30, 93, 0.1);
        }

        .diagnostico-rotas {
            padding: clamp(2.5rem, 6vw, 5rem) 0;
        }

        .diagnostico-sobretitulo {
            margin: 0 0 1.25rem;
            color: #7040bb;
            font-size: 0.9rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .diagnostico-rotas > h2 {
            max-width: 900px;
            margin: 0 0 1.25rem;
            color: #3b1e5d;
            font-size: clamp(2.2rem, 5vw, 3.5rem);
            line-height: 1.12;
        }

        .diagnostico-introducao {
            max-width: 950px;
            margin: 0 0 3rem;
            color: #413650;
            font-size: clamp(1rem, 1.5vw, 1.15rem);
            line-height: 1.75;
        }

        .diagnostico-grade {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.25rem;
        }

        .diagnostico-cartao {
            padding: 1.6rem;
            border: 1px solid #e5dbf4;
            border-radius: 1.2rem;
            background: #fff;
            box-shadow: 0 12px 30px rgba(59, 30, 93, 0.07);
        }

        .diagnostico-cartao h3 {
            margin: 0 0 0.75rem;
            color: #7040bb;
            font-size: 1.25rem;
        }

        .diagnostico-cartao p {
            margin: 0;
            color: #413650;
            line-height: 1.75;
        }

        @media (max-width: 760px) {
            .cartao-detalhe {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .cartao-detalhe figure img {
                height: clamp(240px, 68vw, 420px);
            }

            .cartao-detalhe figure::before {
                top: -0.75rem;
                left: -0.75rem;
            }

            .diagnostico-grade {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 520px) {
            .diagnostico-grade {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
